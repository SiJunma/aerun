{
  "rules": {
    "status": {
      ".read": true,
      "$uid": {
        ".write": "auth != null && auth.uid === $uid"
      }
    },
    "notifications": {
      "$uid": {
        ".read": "auth != null && auth.uid === $uid",
        ".write": "auth != null && auth.uid === $uid"
      }
    },
    "admin_notifications": {
      ".read": "auth != null",
      ".write": "auth != null"
    },
    "dm_unread": {
      "$uid": {
        ".read": "auth != null && auth.uid === $uid",
        ".write": "auth != null"
      }
    },
    "main_page_cache": {
      ".read": true,
      "categories": {
        ".write": "auth != null"
      },
      "stats": {
        ".write": "auth != null"
      },
      "latest_topics": {
        ".write": "auth != null",
        ".indexOn": [
          "last_post_at"
        ]
      }
    },
    "topic_posts_cache": {
      "$topic_id": {
        ".read": true,
        ".write": false,
        "posts": {
          ".indexOn": [
            "created_at"
          ]
        }
      }
    },
    "session_perms": {
      "$uid": {
        ".read": "auth != null && auth.uid === $uid",
        ".write": false
      }
    }
  }
}