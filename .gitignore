# OS
Thumbs.db

# Backend local data (new Go/PocketBase backend lives on feature/pocketbase-migration;
# these are local-only artifacts that must never be committed — migration snapshots
# contain personal data)
backend/migration-data/
# The glob covers the whole family, not just the working directory: dated
# snapshots (`pb_data-backup-20261004-182707`) and the pre-legacy copy
# (`pb_data-PRELEGACY-20261004-194247`) are the SAME database with the same
# member data in it. `backend/pb_data/` matched neither of them, so both sat in
# `git status` as untracked forever, which is worse than ignoring them — it reads
# as work still pending, and the real answer (they can never be committed) only
# exists in somebody's memory. One rule, no ping, no chance of a future snapshot
# being swept in by accident.
backend/pb_data*/
pb_data/
# Local backend build artifacts and run logs. The binary is built to the
# REPOSITORY-ROOT .local-run/ (go build -o ../.local-run/aerun.exe), and the
# stdout/stderr capture from local launches lands beside it. Two directories
# also exist under backend/ from earlier local launches — including a literal
# "..local-run" (two dots) — so all four patterns are ignored rather than just
# the two the current build command produces.
/.local-run/
..local-run/
backend/.local-run/
backend/..local-run/

# Generated by the topic-restore tooling (contains forum content)
restore/

# Local scratch output from manual verification runs. These are transient:
# err.txt is a captured stderr stream that is normally empty, npmtest.txt is
# the raw stdout of an `npm test` run pasted into the shell. Neither belongs
# in the repository — read the output from the terminal instead.
err.txt
npmtest.txt

# ESLint scratch dumps from ad-hoc `npx eslint ... > lint_*.txt` runs. The gate
# is `npm run lint:js`; these redirects are how a single file is checked while
# fixing it, and their output is read from the terminal, never committed.
lint_*.txt
eslint-report.txt

# Local artifacts of python deploy.py (VPS deploy CLI): packed frontend/backend
# bundles reused with --skip-build. Never committed.
.deploy/

# Python bytecode cache
__pycache__/
*.py[cod]
