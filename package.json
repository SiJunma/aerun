{
  "name": "aerun",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "dev:prod": "vite --mode production",
    "dev:test": "vite --mode development",
    "build": "vite build",
    "build:test": "vite build --mode development",
    "deploy:test": "npm run build:test && firebase deploy --only \"hosting,firestore,functions\" --project staging",
    "build:prod": "vite build --mode production",
    "deploy:prod": "npm run build:prod && firebase deploy --only \"hosting,firestore,storage,functions\" --project default",
    "lint:js": "eslint .",
    "lint:rules": "firebase emulators:exec --project demo-test --only firestore \"node -e \\\"console.log('Firestore rules OK')\\\"\"",
    "lint": "npm run lint:js && npm run lint:rules",
    "preview": "vite preview"
  },
  "dependencies": {
    "bootstrap": "^5.3.8",
    "date-fns": "^4.1.0",
    "date-fns-tz": "^3.2.0",
    "firebase": "^12.10.0",
    "framer-motion": "^12.35.2",
    "lucide-react": "^0.577.0",
    "pocketbase": "^0.28.1",
    "react": "^19.2.0",
    "react-bootstrap": "^2.10.10",
    "react-dom": "^19.2.0",
    "react-hot-toast": "^2.6.0",
    "react-markdown": "^10.1.0",
    "react-router-dom": "^7.13.1",
    "rehype-raw": "^7.0.0",
    "rehype-sanitize": "^6.0.0",
    "remark-gfm": "^4.0.1"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.1",
    "@types/node": "^25.3.3",
    "@types/react": "^19.2.7",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^5.1.1",
    "eslint": "^9.39.1",
    "eslint-plugin-react-hooks": "^7.0.1",
    "eslint-plugin-react-refresh": "^0.4.24",
    "firebase-tools": "^15.12.0",
    "globals": "^16.5.0",
    "vite": "^7.3.1"
  }
}
