# The process reads environment variables; local runs may additionally seed
# unset keys from a repository-root .env.local (real environment always wins).
# See README.md for PowerShell and POSIX startup commands.
AERUN_ENV=local
AERUN_LISTEN=127.0.0.1:8090
AERUN_DATA_DIR=./pb_data
AERUN_PUBLIC_URL=http://127.0.0.1:8090
AERUN_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://127.0.0.1:8090
# Foundation has deliberately disabled email; auth/outbox arrive in later sprints.
AERUN_MAIL_MODE=disabled
# Production requires a randomly generated 32-byte value, injected as a secret.
# AERUN_ENCRYPTION_KEY=
# Optional Google login on the users collection: both values are required
# together, an empty pair keeps the provider disabled (password login is
# unaffected). Local runs may keep the pair in .env.local at the repository
# root instead — the process seeds unset keys from it at startup.
# AERUN_GOOGLE_CLIENT_ID=
# AERUN_GOOGLE_CLIENT_SECRET=
