rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // Helper functions
    function isSignedIn() {
      return request.auth != null;
    }
    
    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }
    
    function getUser() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid));
    }

    function isAdmin() {
      return isSignedIn() 
        && exists(/databases/$(database)/documents/users/$(request.auth.uid))
        && (getUser().data.role_id == 'admin' || getUser().data.role_id == 'root');
    }

    // Active = authenticated + profile exists + role is not pending/banned
    function isActive() {
      return isSignedIn()
        && exists(/databases/$(database)/documents/users/$(request.auth.uid))
        && getUser().data.get('role_id', 'player') != 'pending' 
        && getUser().data.get('role_id', 'player') != 'banned';
    }

    function hasPermission(permission) {
      let roleId = getUser().data.role_id;
      return roleId == 'root' || 
        (exists(/databases/$(database)/documents/roles/$(roleId)) && 
         permission in get(/databases/$(database)/documents/roles/$(roleId)).data.permissions);
    }

    function canModerateContent() {
      return isSignedIn() && hasPermission('moderate_content');
    }

    function getTopicData(topicId) {
      return exists(/databases/$(database)/documents/topics/$(topicId)) ? 
        get(/databases/$(database)/documents/topics/$(topicId)).data : 
        getAfter(/databases/$(database)/documents/topics/$(topicId)).data;
    }

    function isTopicOpen(topicId) {
      let tData = getTopicData(topicId);
      return !('is_locked' in tData) || tData.is_locked == false;
    }

    function getRole() {
      return !isSignedIn() ? 'guest' : getUser().data.role_id;
    }

    function isBanned() {
      return isSignedIn() && exists(/databases/$(database)/documents/users/$(request.auth.uid)) && getUser().data.role_id == 'banned';
    }

    function isPending() {
      return isSignedIn() && exists(/databases/$(database)/documents/users/$(request.auth.uid)) && getUser().data.role_id == 'pending';
    }

    function hasCategoryPermission(catId, permission) {
      let role = getRole();
      let catPerms = get(/databases/$(database)/documents/categories/$(catId)).data.permissions;
      // If the permission is not set at category level → fall back to global role check
      // (mirrors frontend hasPermission() fallback, where missing catPerm = use role default)
      // NOTE: We check the role document directly so that guests with a global 'view_forum'
      // permission in the 'guest' role document can also pass (isSignedIn() would block them).
      return !(permission in catPerms)
        ? (role == 'root' || (
            exists(/databases/$(database)/documents/roles/$(role)) &&
            permission in get(/databases/$(database)/documents/roles/$(role)).data.permissions
          ))
        : (role in catPerms[permission]);
    }

    function canCreateTopic(catId) {
      return (isActive() || !isSignedIn()) && !isBanned() && !isPending() && hasCategoryPermission(catId, 'create_topic');
    }

    function canPostToTopic(topicId) {
      let tData = getTopicData(topicId);
      return (isActive() || !isSignedIn()) && !isBanned() && !isPending() && 
             hasCategoryPermission(tData.category_id, 'post_reply') && 
             (!('is_locked' in tData) || tData.is_locked == false) &&
             (tData.posts_count < 1000);
    }

    // --- Users ---
    match /users/{userId} {
      // Allow read for everyone in public mode (profiles are public)
      allow read: if true;
      allow create: if isSignedIn() && request.auth.uid == userId;
      // User can edit own profile (except protected fields); admin can edit anyone; 
      // reputation and post_count are now server-side only (Cloud Functions)
      allow update: if isAdmin()
        || (isSignedIn() && request.auth.uid == userId && !request.resource.data.diff(resource.data).affectedKeys().hasAny(['role_id', 'post_count', 'reputation', 'join_date']))
        || (isActive() && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['last_seen', 'last_selected_character_id']));
      allow delete: if isAdmin(); // Added to allow rejecting pending users
    }

    // --- Characters ---
    // Spectators cannot create characters
    match /characters/{charId} {
      allow read: if true;
      allow create: if isActive() && (request.resource.data.owner_id == request.auth.uid || isAdmin());
      allow update, delete: if isActive() && (resource.data.owner_id == request.auth.uid || isAdmin());
    }

    // --- User sub-collection characters ---
    match /users/{userId}/characters/{charId} {
      allow read: if true;
      allow create: if (isActive() && isOwner(userId)) || isAdmin();
      allow update, delete: if (isOwner(userId) && isActive()) || isAdmin();
    }

    // --- Category Groups ---
    match /category_groups/{groupId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // --- Categories ---
    match /categories/{catId} {
      allow get: if isAdmin() || hasCategoryPermission(catId, 'view_forum');
      allow list: if isAdmin();
      allow create, delete: if isAdmin();
      allow update: if isAdmin()
        || ((isActive() || !isSignedIn()) && !request.resource.data.diff(resource.data).affectedKeys()
          .hasAny(['topics_count', 'posts_count', 'last_post_at', 'last_post_author', 'last_post_author_id', 'last_post_author_avatar', 'last_post_topic_id', 'last_post_topic_title', 'last_post_is_character', 'last_post_author_character_id']));
    }

    // --- Topics ---
    match /topics/{topicId} {
      allow get: if isAdmin() || hasCategoryPermission(resource.data.category_id, 'view_forum');
      allow list: if isAdmin() || hasCategoryPermission(resource.data.category_id, 'view_forum');
      // Active users or Guests (if allowed) can create topics
      allow create: if isAdmin() || canCreateTopic(request.resource.data.category_id);
      // Author or admin can edit; counter bumps and metadata are handled by server triggers
      allow update: if isAdmin()
        || ((isActive() || !isSignedIn()) && (
          (isSignedIn() && resource.data.author_id == request.auth.uid && !request.resource.data.diff(resource.data).affectedKeys()
            .hasAny(['posts_count', 'last_post_at', 'last_post_author', 'last_post_author_id', 'last_post_author_avatar', 'last_post_is_character', 'last_post_author_character_id']))
          || (request.resource.data.diff(resource.data).affectedKeys()
            .hasOnly(['views']))
        ));
      allow delete: if canModerateContent() || (isActive() && resource.data.author_id == request.auth.uid && isTopicOpen(topicId));
    }

    // --- Posts ---
    match /posts/{postId} {
      allow read: if isAdmin() || hasCategoryPermission(resource.data.category_id, 'view_forum');
      // Active users or Guests (if allowed) can create posts
      allow create: if isAdmin() || canPostToTopic(request.resource.data.topic_id);
      allow update: if isAdmin()
        || (isActive() && (
          resource.data.author_id == request.auth.uid
        ));
      allow delete: if canModerateContent() || (isActive() && resource.data.author_id == request.auth.uid && isTopicOpen(resource.data.topic_id));
    }

    // --- Drafts (Isolated per user/topic) ---
    match /users/{userId}/drafts/{topicId} {
      allow read, write: if request.auth != null && request.auth.uid == userId;
    }

    // --- Read Map (tracks last topic visit per user, synced across devices) ---
    match /users/{userId}/readmap/{docId} {
      allow read, write: if isSignedIn() && request.auth.uid == userId;
    }

    // --- Global Settings ---
    match /settings/{docId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // --- Custom Designs ---
    match /designs/{designId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // --- Global Stats ---
    match /global_stats/{docId} {
      allow read: if true;
      allow write: if isSignedIn();
    }

    // --- Reputation Logs ---
    match /reputation_logs/{logId} {
      // Users can only read their own logs (either as target or voter) or admins can read all
      // The rest is handled securely by the cloud function `getReputationLogs`
      // Added `resource == null` and `logId` prefix check to allow existence checks in transactions.
      allow read: if isAdmin() || (isSignedIn() && (
        resource == null || 
        resource.data.target_id == request.auth.uid || 
        resource.data.voter_id == request.auth.uid
      ));
      // Any active user can vote (permissions defined by frontend); voter_id must match; cannot vote for self
      allow create: if isActive() 
        && request.resource.data.voter_id == request.auth.uid
        && request.resource.data.target_id != request.auth.uid
        && get(/databases/$(database)/documents/users/$(request.resource.data.target_id)).data.role_id != 'banned'
        && get(/databases/$(database)/documents/users/$(request.resource.data.target_id)).data.role_id != 'pending';
      // Logs are immutable except for admins, or the voter modifying their comment
      allow update: if isAdmin()
        || (isActive() && resource.data.voter_id == request.auth.uid && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['comment']));
      allow delete: if isAdmin()
        || (isSignedIn()
          && exists(/databases/$(database)/documents/users/$(request.auth.uid))
          && getUser().data.role_id == 'moderator')
        || (isActive() 
          && resource.data.target_id == request.auth.uid
          && !existsAfter(/databases/$(database)/documents/posts/$(resource.data.post_id)));
    }

    // --- Audit Logs ---
    match /audit_logs/{logId} {
      allow create: if isSignedIn();
      allow read: if isSignedIn() 
        && exists(/databases/$(database)/documents/users/$(request.auth.uid))
        && getUser().data.role_id in ['admin', 'root', 'moderator'];
      allow update, delete: if isAdmin();
    }

    // --- Notifications ---
    match /notifications/{notifId} {
      // Users read only their own; admins read all.
      allow read: if isAdmin()
               || (isActive() && resource.data.recipient_uid == request.auth.uid);

      // All notification creation is server-side via Cloud Functions (Admin SDK bypasses rules).
      // No client path should ever write a notification directly.
      allow create: if false;

      // Users may only mark their own notifications as read or archived.
      // No other field may be changed by the client.
      allow update: if isActive()
                 && resource.data.recipient_uid == request.auth.uid
                 && request.resource.data.diff(resource.data)
                      .affectedKeys().hasOnly(['read', 'archived']);

      // Only admins may hard-delete notifications.
      allow delete: if isAdmin();
    }

    // --- Topic Subscriptions ---
    match /topic_subscriptions/{subId} {
      allow read: if isActive();
      allow create: if isActive() && request.resource.data.user_id == request.auth.uid;
      allow delete: if isActive() && (resource.data.user_id == request.auth.uid || isAdmin());
    }

    function getRoleLevel(roleId) {
      let systemLevels = { 'root': 100, 'admin': 90, 'moderator': 50, 'player': 10, 'spectator': 5, 'pending': 1, 'banned': 0 };
      let defLevel = roleId in systemLevels ? systemLevels[roleId] : 0;
      let roleData = exists(/databases/$(database)/documents/roles/$(roleId)) ? get(/databases/$(database)/documents/roles/$(roleId)).data : {};
      return 'level' in roleData ? roleData.level : defLevel;
    }

    // --- Roles ---
    match /roles/{roleId} {
      allow read: if true; // Allow reading for badge colors etc
      allow create, update: if isAdmin() || (
        isActive() && 
        hasPermission('manage_roles') && 
        getRole() != roleId &&
        getRoleLevel(getRole()) > getRoleLevel(roleId) &&
        (!('level' in request.resource.data) || getRoleLevel(getRole()) > request.resource.data.level)
      );
      allow delete: if resource.data.is_system ? isAdmin() : (
        isAdmin() || (
          isActive() && 
          hasPermission('manage_roles') && 
          getRole() != roleId &&
          getRoleLevel(getRole()) > getRoleLevel(roleId)
        )
      );
    }

    // --- Guest Activity (throttled unique guest tracking) ---
    match /guest_activity/{guestId} {
      allow read: if true;
      allow create: if true;
      allow update: if true;
      allow delete: if true;
    }

    // --- Direct Messages ---
    // Only active participants can read/write conversations and messages.
    match /dms/{convId} {
      // Allow read even if doc doesn't exist yet (resource == null for non-existent docs)
      allow read: if isActive() && (resource == null || request.auth.uid in resource.data.get('participants', []));
      allow create: if isActive() && request.auth.uid in request.resource.data.get('participants', []);
      allow update: if isActive() && request.auth.uid in resource.data.get('participants', []);

      match /messages/{msgId} {
        allow read: if isActive()
          && request.auth.uid in get(/databases/$(database)/documents/dms/$(convId)).data.get('participants', []);
        allow create: if isActive()
          && request.resource.data.sender_uid == request.auth.uid
          && request.auth.uid in get(/databases/$(database)/documents/dms/$(convId)).data.get('participants', []);
      }
    }
  }
}

